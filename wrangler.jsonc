{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techselectwebsite",
  "main": "worker.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "www.tech-select.co.il/*",
      "zone_name": "tech-select.co.il"
    },
    {
      "pattern": "tech-select.co.il",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
