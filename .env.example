# Microsoft 365 Graph API (OAuth2 Client Credentials Flow)
# Used to send emails from support@tech-select.co.il via Microsoft Graph
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Internal Hours Tracking Tool ("תיעוד שעות")
# Microsoft Entra ID / Azure AD Single-Tenant Auth:
# Server-side token validation:
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_API_AUDIENCE=

# Client-side (Vite) MSAL Single-Tenant Config:
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_API_SCOPE=api://${AZURE_CLIENT_ID}/access_as_user
VITE_HOURS_SLUG=k8x9m2p4q8w1v5n3b6c0d8f2j4l6h7p9a2

# Email address to receive admin alerts & lead notifications
ALERT_EMAIL=g@tech-select.co.il

# Gemini API Key (accessed server-side only)
GEMINI_API_KEY=

# Atera API Key (accessed server-side only in Cloudflare / backend proxy)
ATERA_API_KEY=
